Window.SetBackgroundTopColor(@bgR@ / 255.0, @bgG@ / 255.0, @bgB@ / 255.0);
Window.SetBackgroundBottomColor(@bgR@ / 255.0, @bgG@ / 255.0, @bgB@ / 255.0);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
prompt_sprite = Sprite();
entry_sprite = Sprite();

current_logo_image = logo_image;
base_angle = 0.0;
frame = 0;
rotate_frames = 35;
pause_frames = 15;
cycle_frames = rotate_frames + pause_frames;
step_angle = Math.Pi / 3.0;
spinning = 1;

fun layout() {
  logo_sprite.SetX((Window.GetWidth() - current_logo_image.GetWidth()) / 2);
  logo_sprite.SetY((Window.GetHeight() - current_logo_image.GetHeight()) / 2);
}

fun normalize_logo() {
  current_logo_image = logo_image;
  logo_sprite.SetImage(logo_image);
  layout();
}

fun refresh() {
  if (spinning) {
    phase = frame % cycle_frames;
    if (phase < rotate_frames) {
      t = phase / rotate_frames;
      eased = t * t * (3.0 - 2.0 * t);
      current_logo_image = logo_image.Rotate(base_angle + step_angle * eased);
      logo_sprite.SetImage(current_logo_image);
    } else {
      if (phase == rotate_frames) {
        base_angle = base_angle + step_angle;
        if (base_angle >= 2.0 * Math.Pi) {
          base_angle = base_angle - 2.0 * Math.Pi;
        }
        current_logo_image = logo_image.Rotate(base_angle);
        logo_sprite.SetImage(current_logo_image);
      }
    }
    frame = frame + 1;
  }
  layout();
}

fun prompt_top() {
  top = Window.GetHeight() / 2 + @logoSize@ / 2 + 32;
  if (top > Window.GetHeight() - 80) {
    top = Window.GetHeight() - 80;
  }
  return top;
}

fun hide_prompt() {
  prompt_sprite.SetOpacity(0);
  entry_sprite.SetOpacity(0);
}

fun show_prompt(prompt, entry) {
  shown_entry = entry;
  if (shown_entry == "") {
    shown_entry = " ";
  }

  prompt_image = Image.Text(prompt, @fgR@ / 255.0, @fgG@ / 255.0, @fgB@ / 255.0);
  prompt_sprite.SetImage(prompt_image);
  prompt_sprite.SetX((Window.GetWidth() - prompt_image.GetWidth()) / 2);
  prompt_sprite.SetY(prompt_top());
  prompt_sprite.SetZ(100);
  prompt_sprite.SetOpacity(1);

  entry_image = Image.Text(shown_entry, @fgR@ / 255.0, @fgG@ / 255.0, @fgB@ / 255.0);
  entry_sprite.SetImage(entry_image);
  entry_sprite.SetX((Window.GetWidth() - entry_image.GetWidth()) / 2);
  entry_sprite.SetY(prompt_top() + prompt_image.GetHeight() + 8);
  entry_sprite.SetZ(100);
  entry_sprite.SetOpacity(1);
}

fun display_normal() {
  spinning = 1;
  frame = 0;
  hide_prompt();
}

fun display_password(prompt, bullets) {
  spinning = 0;
  normalize_logo();

  masked = "";
  for (i = 0; i < bullets; i++) {
    masked += "*";
  }
  show_prompt(prompt, masked);
}

fun display_question(prompt, entry) {
  spinning = 0;
  normalize_logo();
  show_prompt(prompt, entry);
}

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);

layout();
hide_prompt();
